(104, 'Kiran Kumar', 24, 'O-', '9876543214');

-- Display Table
SELECT * FROM Donors;

-- Declare JSON Variable
DECLARE @data NVARCHAR(MAX);

-- Store JSON Data
SET @data =
'{
    "DonorID": 100,
    "DonorName": "Arun Kumar",
    "Age": 25,
    "BloodGroup": "O+",
    "Phone": "9876543210"
}';

-- Display JSON Data
SELECT @data AS JSONData;

-- Extract JSON Values
SELECT
    JSON_VALUE(@data, '$.DonorID') AS DonorID,
    JSON_VALUE(@data, '$.DonorName') AS DonorName,
    JSON_VALUE(@data, '$.Age') AS Age,
    JSON_VALUE(@data, '$.BloodGroup') AS BloodGroup,
    JSON_VALUE(@data, '$.Phone') AS Phone;

-- Check Valid JSON
SELECT ISJSON(@data) AS IsValidJSON;

-- Convert Table Data into JSON
SELECT DonorID, DonorName, Age, BloodGroup, Phone
FROM Donors
FOR JSON PATH;
