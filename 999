USE bloodDB;
GO

SELECT GETDATE() AS CurrentDateTime;

SELECT CAST(GETDATE() AS TIME) AS CurrentTime;

SELECT
    MAX(Quantity) AS MaximumBlood,
    MIN(Quantity) AS MinimumBlood,
    AVG(Quantity) AS AverageBlood,
    SUM(Quantity) AS TotalBlood
FROM BloodDonation;

SELECT
    DonorName,
    UPPER(DonorName) AS UpperName,
    LOWER(DonorName) AS LowerName,
    LEN(DonorName) AS NameLength
FROM Donor;

SELECT
    DonorID,
    CAST(Age AS VARCHAR(10)) AS AgeAsText
FROM Donor;

SELECT
    D.DonorID,
    D.DonorName,
    D.BloodGroup,
    B.DonationDate,
    B.Quantity
FROM Donor D
INNER JOIN BloodDonation B
ON D.DonorID = B.DonorID;


SELECT
    D.DonorName,
    B.DonationDate,
    B.Quantity
FROM Donor D
LEFT JOIN BloodDonation B
ON D.DonorID = B.DonorID;

SELECT
    D.DonorName,
    B.Quantity
FROM Donor D
RIGHT JOIN BloodDonation B
ON D.DonorID = B.DonorID;

SELECT
    D.DonorName,
    B.DonationDate,
    B.Quantity
FROM Donor D
FULL OUTER JOIN BloodDonation B
ON D.DonorID = B.DonorID;


SELECT DonorName, Age
FROM Donor
WHERE Age >
(
    SELECT AVG(Age)
    FROM Donor
);


SELECT D1.DonorName, D1.Age, D1.City
FROM Donor D1
WHERE D1.Age >
(
    SELECT AVG(D2.Age)
    FROM Donor D2
    WHERE D2.City = D1.City
);


