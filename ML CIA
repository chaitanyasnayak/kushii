import matplotlib.pyplot as plt

x=[[90,85],[85,80],[95,90],[60,55],
   [65,60],[70,65],[88,82],[55,50]]

y=['Pass','Pass','Pass','Fail','Fail','Fail','Pass','Fail']

xtr,xte,ytr,yte=train_test_split(
    x,y,test_size=.25,random_state=42)

m=GaussianNB()
m.fit(xtr,ytr)
p=m.predict(xte)

print("Actual:",yte)
print("Predicted:",p)
print("Accuracy:",accuracy_score(yte,p))

# New / unseen student
a=float(input("Enter attendance: "))
