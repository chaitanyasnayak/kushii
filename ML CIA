1)Implementation of Apriori algorithm
from itertools import combinations
import matplotlib.pyplot as plt

n=int(input("No. of transactions: "))
T=[set(input(f{i+1}: ").split()) for i in range(n)]
S=float(input("Min support: "))
C=float(input("Min confidence: "))

sup=lambda x:sum(x<=t for t in T)/n
items=set().union(*T); freq=[]

for k in range(1,len(items)+1):
    f={frozenset(x) for x in combinations(items,k) if sup(set(x))>=S}
    if not f: break
    freq+=f

print("\nFrequent Itemsets:")
data=[]
for x in freq:
    v=sup(set(x))
    print(set(x),round(v,2))
    data.append((str(set(x)),v))

print("\nAssociation Rules:")
for x in freq:
    for r in range(1,len(x)):
        for a in combinations(x,r):
            a,b=set(a),set(x)-set(a)
            c=sup(a|b)/sup(a)
            if c>=C: print(a,"->",b,round(c,2))

u=set(input("\nEnter unseen transaction: ").split())
print("\nPrediction:")
for x in freq:
    if x<=u: print(set(x))

# Simple Graph
plt.bar(range(len(data)),[v for _,v in data])
plt.xlabel("Itemsets")
plt.ylabel("Support")
plt.title("Frequent Itemsets")
plt.show()





2)Implementation of Classification mode K-nearest neighbour
from sklearn.model_selection import train_test_split
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import accuracy_score
import matplotlib.pyplot as plt

x=[[1,2],[2,3],[3,4],[6,7],[7,8],[8,9]]
y=['Red','Red','Red','Blue','Blue','Blue']

xtr,xte,ytr,yte=train_test_split(x,y,test_size=.33,random_state=42)

m=KNeighborsClassifier(n_neighbors=3)
m.fit(xtr,ytr)
p=m.predict(xte)

print("Actual:",yte)
print("Predicted:",p)
print("Accuracy:",accuracy_score(yte,p))

a=float(input("Enter x1: "))
b=float(input("Enter x2: "))
print("New Prediction:",m.predict([[a,b]])[0])

for c,col in [('Red','red'),('Blue','blue')]:
    q=[x[i] for i in range(len(x)) if y[i]==c]
    plt.scatter([z[0] for z in q],[z[1] for z in q],
                color=col,label=c)

plt.scatter(a,b,color='black',marker='*',s=150,label='New')
plt.xlabel("x1")
plt.ylabel("x2")
plt.title("KNN Classification")
plt.legend()
plt.grid()
plt.show()






