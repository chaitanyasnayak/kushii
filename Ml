    [1, 50],
    [2, 60],
    [1, 45],
    [2, 55],
    [8, 100],
    [10, 120],
    [9, 110],
    [12, 130]
])

# 0 = Not Spam, 1 = Spam
y = np.array([0, 0, 0, 0, 1, 1, 1, 1])

# Model
model = GaussianNB()
model.fit(X, y)

# User input
links = int(input("Enter number of links: "))
words = int(input("Enter number of words: "))

