Apriori 
import pandas as pd
import matplotlib.pyplot as plt
from mlxtend.frequent_patterns import apriori, association_rules

# Transactions
transactions = [
    ['Milk', 'Bread'],
    ['Milk', 'Bread', 'Butter'],
    ['Bread', 'Butter'],
    ['Milk', 'Bread'],
    ['Milk', 'Butter'],
    ['Bread', 'Butter', 'Jam']
]

# Convert transactions to one-hot format
items = sorted(set(item for t in transactions for item in t))

data = []
for transaction in transactions:
    data.append([1 if item in transaction else 0 for item in items])

df = pd.DataFrame(data, columns=items)

# Apriori
frequent_items = apriori(df, min_support=0.3, use_colnames=True)

print("Frequent Itemsets:")
print(frequent_items)

# Association rules
rules = association_rules(
    frequent_items,
    metric="confidence",
    min_threshold=0.5
)

print("\nAssociation Rules:")
print(rules[['antecedents', 'consequents', 'support', 'confidence']])

# User input - unseen transaction
user_items = input("\nEnter items in a new transaction separated by comma: ")
user_items = [x.strip() for x in user_items.split(",")]

print("New Transaction:", user_items)

# Visualization
plt.bar(
    range(len(frequent_items)),
    frequent_items['support']
)

plt.xlabel("Frequent Itemsets")
plt.ylabel("Support")
plt.title("Apriori - Support of Frequent Itemsets")
plt.show()






K-Nearest 
import numpy as np
import matplotlib.pyplot as plt
from sklearn.neighbors import KNeighborsClassifier

# Age, Salary
X = np.array([
    [20, 20000],
    [22, 22000],
    [25, 25000],
    [28, 30000],
    [35, 50000],
    [40, 60000],
    [45, 65000],
    [50, 70000]
])

# 0 = No, 1 = Yes
y = np.array([0, 0, 0, 0, 1, 1, 1, 1])

# Model
model = KNeighborsClassifier(n_neighbors=3)
model.fit(X, y)

# User input
age = float(input("Enter age: "))
salary = float(input("Enter salary: "))

prediction = model.predict([[age, salary]])

if prediction[0] == 1:
    print("Prediction: Customer will buy")
else:
    print("Prediction: Customer will not buy")

# Visualization
plt.scatter(X[:, 0], X[:, 1], c=y)
plt.scatter(age, salary, marker='*', s=200)

plt.xlabel("Age")
plt.ylabel("Salary")
plt.title("KNN Classification")
plt.show()






