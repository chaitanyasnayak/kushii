5. Implement JSON Datatypes
CREATE TABLE UserJSON (
    UserID INT PRIMARY KEY,
    UserDetails NVARCHAR(MAX)
);

INSERT INTO UserJSON VALUES
(1, '{"Name":"Monika","Age":20,"Goal":2000}'),
(2, '{"Name":"Rahul","Age":22,"Goal":2200}'),
(3, '{"Name":"Anu","Age":21,"Goal":1800}');

-- Check Valid JSON and Select All
SELECT UserDetails, ISJSON(UserDetails) AS IsValid
FROM UserJSON;

SELECT * FROM UserJSON;

-- Extracting Values using JSON_VALUE
SELECT JSON_VALUE(UserDetails, '$.Name') AS Name
FROM UserJSON;

SELECT JSON_VALUE(UserDetails, '$.Age') AS Age
FROM UserJSON;

SELECT JSON_VALUE(UserDetails, '$.Goal') AS CalorieGoal
FROM UserJSON;

-- Combined JSON Select Query
SELECT
    JSON_VALUE(UserDetails, '$.Name') AS Name,
    JSON_VALUE(UserDetails, '$.Age') AS Age,
    JSON_VALUE(UserDetails, '$.Goal') AS Goal
FROM UserJSON;

