1c. SQL Operations (Joins & Sub-queries)
1. Joins
-- INNER JOIN
SELECT Users.name, Food.food_name
FROM Users
INNER JOIN Food ON Users.user_id = Food.user_id;

-- LEFT JOIN
SELECT Users.name, Food.food_name
FROM Users
LEFT JOIN Food ON Users.user_id = Food.user_id;

-- RIGHT JOIN
SELECT Users.name, Food.food_name
FROM Users
RIGHT JOIN Food ON Users.user_id = Food.user_id;

-- FULL JOIN
SELECT Users.name, Food.food_name
FROM Users
FULL JOIN Food ON Users.user_id = Food.user_id;

-- CROSS JOIN
SELECT Users.name, Food.food_name
FROM Users
CROSS JOIN Food;

-- Join with MealPlan
SELECT Users.name, MealPlan.meal_name, MealPlan.meal_type
FROM Users
INNER JOIN MealPlan ON Users.user_id = MealPlan.user_id;

-- Join with Exercise
SELECT Users.name, Exercise.exercise_name, Exercise.duration
FROM Users
INNER JOIN Exercise ON Users.user_id = Exercise.user_id;

2. Sub-queries & Correlated Sub-queries
-- Subquery 1
SELECT name, age
FROM Users
WHERE age > (SELECT AVG(age) FROM Users);

-- Subquery 2
SELECT food_name, calories
FROM Food
WHERE calories > (SELECT AVG(calories) FROM Food);

-- Correlated Subquery
SELECT name
FROM Users U
WHERE EXISTS (
    SELECT *
    FROM Food F
    WHERE F.user_id = U.user_id
);

2a. Database Optimization & T-SQL Loops
1. Views, Synonyms, Sequences, Indexes
-- View
CREATE VIEW UserFood AS
SELECT Users.name, Food.food_name, Food.calories
FROM Users
JOIN Food ON Users.user_id = Food.user_id;

SELECT * FROM UserFood;

-- Synonym
CREATE SYNONYM FoodDetails FOR Food;
SELECT * FROM FoodDetails;

-- Sequence
CREATE SEQUENCE UserSeq
START WITH 1
INCREMENT BY 1;

SELECT NEXT VALUE FOR UserSeq;

-- Index
CREATE INDEX idx_user_name ON Users(name);
SELECT * FROM Users WHERE name = 'Monika';

2. T-SQL Loops
-- 1. Print Odd Numbers from 1 to N
DECLARE @n INT = 10;
DECLARE @i INT = 1;
WHILE @i <= @n
BEGIN
    PRINT @i;
    SET @i = @i + 2;
END;

-- 2. Fibonacci Series Up to a Given Number
DECLARE @n INT = 10;
DECLARE @a INT = 0;
DECLARE @b INT = 1;
DECLARE @c INT;

WHILE @a <= @n
BEGIN
    PRINT @a;
    SET @c = @a + @b;
    SET @a = @b;
    SET @b = @c;
END;

-- 3. Sum of First N Natural Numbers
DECLARE @n INT = 10;
DECLARE @i INT = 1;
DECLARE @sum INT = 0;

WHILE @i <= @n
BEGIN
    SET @sum = @sum + @i;
    SET @i = @i + 1;
END;

PRINT @sum;

-- 4. Reverse a Given Number
DECLARE @num INT = 12345;
DECLARE @rev INT = 0;

WHILE @num > 0
BEGIN
    SET @rev = (@rev * 10) + (@num % 10);
    SET @num = @num / 10;
END;

PRINT @rev;

