2. DML Commands (WHERE, DISTINCT, GROUP BY, HAVING, ORDER BY)
-- Basic DML
INSERT INTO Users VALUES (4, 'Kiran', 25, 'kiran@gmail.com');
UPDATE Users SET age = 21 WHERE user_id = 1;
DELETE FROM Users WHERE user_id = 4;
SELECT * FROM Users;

-- WHERE
SELECT * FROM Food WHERE calories > 100;

-- DISTINCT
SELECT DISTINCT meal_type FROM MealPlan;

-- GROUP BY & HAVING
SELECT user_id, AVG(calories) AS AvgCalories
FROM Food
GROUP BY user_id
HAVING AVG(calories) > 90;

-- ORDER BY
SELECT * FROM Food ORDER BY calories DESC;

