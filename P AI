import itertools

def solve():
    w1 = input("Enter the first word: ").upper()
    w2 = input("Enter the second word: ").upper()
    res = input("Enter the result word: ").upper()

    letters = list(set(w1 + w2 + res))

    if len(letters) > 10:
        print("Too many unique letters!")
        return

    leading = {w1[0], w2[0], res[0]}

    for p in itertools.permutations(range(10), len(letters)):
        m = dict(zip(letters, p))

        if any(m[x] == 0 for x in leading):
            continue

        def num(word):
            return int("".join(str(m[x]) for x in word))

        n1, n2, n3 = num(w1), num(w2), num(res)

        if n1 + n2 == n3:
            print("\n☑ Solution Found!")
            print(f"{w1} = {n1}")
            print(f"{w2} = {n2}")
            print(f"{res} = {n3}")
            print("Letter Mapping:", m)
            return

    print("No solution found.")

solve()




