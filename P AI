leaf_values = [3, 5, 2, 9, 12, 5, 23, 23]

def minimax(depth, index, is_max):
    if depth == 3:
        return leaf_values[index]

    left = minimax(depth + 1, index * 2, not is_max)
    right = minimax(depth + 1, index * 2 + 1, not is_max)

    return max(left, right) if is_max else min(left, right)

best_value = minimax(0, 0, True)

print("Leaf values:", leaf_values)
print("Best value according to Minimax:", best_value)




