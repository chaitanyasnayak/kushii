from queue import PriorityQueue

def best_first_search(graph, start, goal):
    visited, pq = set(), PriorityQueue()
    pq.put((0, start))
    path, total = [], 0

    while not pq.empty():
        cost, node = pq.get()
        if node in visited:
            continue

        print(f"\nVisiting: {node} (Cost: {cost})")
        visited.add(node)
        path.append(node)
        total += cost

        if node == goal:
            print("Goal Node Reached!")
            break

        for neighbor, weight in graph[node]:
            if neighbor not in visited:
                print(f"Adding neighbour: {neighbor} (Weight: {weight})")
                pq.put((weight, neighbor))

    print("\nResults")
    print("Path:", " → ".join(path))
    print("Total Cost:", total)


graph = {
    'A': [('B', 2), ('C', 5)],
    'B': [('D', 1), ('E', 4)],
    'C': [('F', 2)],
    'D': [('G', 3)],
    'E': [('G', 1)],
    'F': [('G', 2)],
    'G': []
}

best_first_search(graph, 'A', 'G')





