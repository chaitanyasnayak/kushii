from collections import deque

def water_jug_bfs(jug1, jug2, target):
    visited = set()
    queue = deque([(0, 0)])
    visited.add((0, 0))

    while queue:
        x, y = queue.popleft()
        print(f"Visited state: X = {x}L, Y = {y}L")

        if x == target or y == target:
            print("Goal reached!")
            return True

        states = [
            (jug1, y), (x, jug2),      
            (0, y), (x, 0),           
            (x-min(x, jug2-y), y+min(x, jug2-y)),  # Jug1 → Jug2
            (x+min(y, jug1-x), y-min(y, jug1-x))   # Jug2 → Jug1
        ]

        for state in states:
            if state not in visited:
                visited.add(state)
                queue.append(state)

    print("No solution found.")
    return False


water_jug_bfs(4, 3, 2)




