CREATE PROCEDURE OddNumbers
    @N INT
AS
BEGIN
    DECLARE @i INT = 1;

    WHILE @i <= @N
    BEGIN
        IF @i % 2 = 1
            PRINT @i;

        SET @i = @i + 1;
    END;
END;

-- User input
EXEC OddNumbers @N = 10;


