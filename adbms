SELECT C.Customer_Name, P.Amount
FROM Customers C
INNER JOIN Recharges R ON C.Customer_ID = R.Customer_ID
INNER JOIN Recharge_Plans P ON R.Plan_ID = P.Plan_ID;

SELECT C.Customer_Name, R.Recharge_ID
FROM Customers C
LEFT JOIN Recharges R ON C.Customer_ID = R.Customer_ID;

SELECT C.Customer_Name, R.Recharge_ID
FROM Customers C
RIGHT JOIN Recharges R ON C.Customer_ID = R.Customer_ID;

SELECT C.Customer_Name, R.Recharge_ID
FROM Customers C
FULL OUTER JOIN Recharges R ON C.Customer_ID = R.Customer_ID;




