CREATE DATABASE MobileRechargeDB;
GO
USE MobileRechargeDB;
GO

CREATE TABLE Customers (
    Customer_ID INT PRIMARY KEY,
    Customer_Name VARCHAR(50),
    Mobile_Number VARCHAR(15) UNIQUE,
    Email VARCHAR(50),
    City VARCHAR(30)
);

CREATE TABLE Operators (
    Operator_ID INT PRIMARY KEY,
    Operator_Name VARCHAR(30)
);

CREATE TABLE Recharge_Plans (
    Plan_ID INT PRIMARY KEY,
    Operator_ID INT,
    Amount DECIMAL(10,2) CHECK (Amount >= 0),
    Validity INT,
    Data_Limit VARCHAR(20),
    FOREIGN KEY (Operator_ID) REFERENCES Operators(Operator_ID)
);

CREATE TABLE Recharges (
    Recharge_ID INT PRIMARY KEY,
    Customer_ID INT,
    Plan_ID INT,
    Recharge_Date DATE,
    Status VARCHAR(20),
    FOREIGN KEY (Customer_ID) REFERENCES Customers(Customer_ID),
    FOREIGN KEY (Plan_ID) REFERENCES Recharge_Plans(Plan_ID)
);
