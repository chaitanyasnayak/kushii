Program 10: DataPreprocessing
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression
d = pd.read_csv('students.csv').fillna(0).drop_duplicates()
X = d[['hours','attendance']]
y = d['passed']
s = StandardScaler()
X = s.fit_transform(X)
m = LogisticRegression().fit(X,y)
h = float(input("Hours: "))
a = float(input("Attendance: "))
print("Prediction:",m.predict(s.transform([[h,a]]))[0])
plt.scatter(X[:,0],X[:,1],c=y)
plt.show()



