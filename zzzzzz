Program 1: Data Visualization
import pandas as pd, matplotlib.pyplot as plt
df = pd.read_csv('students.csv')                                  # 1. Load CSV
print(df.corr().round(2))                                         # 2. Correlation table
col = input('Column for histogram (hours/attendance/sleep/score): ')  # 3. User input
h = float(input('New student hours: '))
s = float(input('New student score: '))
plt.figure(figsize=(10, 7))
plt.subplot(2, 2, 1); plt.plot(df.index, df.score);
plt.title('Line: score')
plt.subplot(2, 2, 2);
plt.scatter(df.hours, df.score)             # Scatter + new point
plt.scatter(h, s, c='red', marker='*', s=200);
plt.title('Scatter: hours vs score')
plt.subplot(2, 2, 3);
plt.bar(['Fail', 'Pass'], df.passed.value_counts().sort_index());
plt.title('Bar: pass/fail')
plt.subplot(2, 2, 4);
plt.hist(df[col]); plt.title('Histogram: ' + col)
plt.tight_layout(); plt.show()



Program 2: Apriori
import pandas as pd
import matplotlib.pyplot as plt
from mlxtend.frequent_patterns import *
df = pd.read_csv('basket.csv').astype(bool)
a = apriori(df, min_support=0.3, use_colnames=True)
r = association_rules(a, num_itemsets=len(df), metric='confidence', min_threshold=0.6)
print(a)
print(r[['antecedents','consequents','confidence']])
plt.bar(a.itemsets.astype(str), a.support)
plt.xticks(rotation=90)
plt.show()



Program 3: KNearestNeighbor
import pandas as pd, matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import accuracy_score
df = pd.read_csv('students.csv')                                  # 1. Load CSV
X, y = df[['hours', 'attendance']], df['passed']                  # 2. Features and target
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=1)  # 3. Split
model = KNeighborsClassifier(n_neighbors=3).fit(X_train, y_train)  # 4. Train
print('Accuracy:', accuracy_score(y_test, model.predict(X_test)))  # 5. Test on unseen data
h = float(input('Hours studied: '))                               # 6. User input
a = float(input('Attendance %: '))
new = pd.DataFrame([[h, a]], columns=X.columns)
print('Prediction:', 'Pass' if model.predict(new)[0] == 1 else 'Fail')
plt.scatter(df.hours, df.attendance, c=y)                         # 7. Plot
plt.scatter(h, a, c='red', marker='*', s=200)
plt.xlabel('hours'); plt.ylabel('attendance'); plt.show()



Program 4: LinearRegression
import pandas as pd, matplotlib.pyplot as plt
