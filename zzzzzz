Program 7: DataInterfaces
import pandas as pd
import matplotlib.pyplot as plt
t = input("1.CSV 2.Excel 3.Binary: ")
if t == '1':
    f = 'records.csv'
    d = pd.read_csv(f)
elif t == '2':
    f = 'records.xlsx'
    d = pd.read_excel(f)
else:
    f = 'records.pkl'
    d = pd.read_pickle(f)
while True:
    c = input("1.View 2.Add 3.Update 4.Delete 5.Plot 6.Exit: ")
    if c == '1':
        print(d)
    elif c == '2':
        d.loc[len(d)] = [int(input("ID: ")), input("Name: "), int(input("Marks: "))]
    elif c == '3':
        i = int(input("ID: "))
        d.loc[d.id == i, 'marks'] = int(input("Marks: "))
    elif c == '4':
        i = int(input("ID: "))
        d = d[d.id != i]
    elif c == '5':
        plt.bar(d.name, d.marks)
        plt.show()
    elif c == '6':
        break
    if c in ['2','3','4']:
        if t == '1': d.to_csv(f, index=False)
        elif t == '2': d.to_excel(f, index=False)
        else: d.to_pickle(f)



