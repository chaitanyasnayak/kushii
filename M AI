from collections import deque

def solve(j1, j2, target):
    q = deque([(0, 0)])
    visited = set([(0, 0)])

    while q:
        x, y = q.popleft()

        print(f"Visited state: X={x}L, Y={y}L")

        if x == target or y == target:
            print("Goal reached!")
            return

        moves = {
            (j1, y),  # Fill X
            (x, j2),  # Fill Y
            (0, y),   # Empty X
            (x, 0),   # Empty Y

            # Pour X -> Y
            (
                x - min(x, j2 - y),
                y + min(x, j2 - y)
            ),

            # Pour Y -> X
            (
                x + min(y, j1 - x),
                y - min(y, j1 - x)
            )
        }

        for state in moves:
            if state not in visited:
                visited.add(state)
                q.append(state)


