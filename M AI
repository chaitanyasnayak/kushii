from queue import PriorityQueue
graph = {'A': [('B', 1), ('C', 3)], 'B': [('D', 3), ('E', 1)], 'C': [('F', 5)], 'D': [], 'E': [],
'F': []}
print("Best-First Search (Greedy)
Graph Connections:")
for k, v in graph.items():
 print(f"{k} -> {v}")
pq, visited, path, total_cost = PriorityQueue(), set(), [], 0
pq.put((0, 'A'))
while not pq.empty():
 cost, node = pq.get()
 if node in visited:
 continue
 print(f"
Visiting: {node} (Current Cost: {cost})")
 visited.add(node)
 path.append(node)
 total_cost += cost
 if node == 'F':
 print("
Goal Node Reached!")
 break
 for neighbor, weight in graph[node]:
 if neighbor not in visited:
 print(f"Adding neighbor: {neighbor} with weight {weight}")
 pq.put((weight, neighbor))
print(f"
Results
Path: {'→'.join(path)}
Total Cost: {total_cost}")
print("Note: Best-First doesn't guarantee optimal path!")



