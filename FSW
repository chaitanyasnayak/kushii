  <h3>Dynamic JavaScript Input</h3>
  <input type="text" id="userInput" placeholder="Enter your name">
  <button onclick="show()">Submit</button>
  <p id="result" style="font-weight: bold; color: #0284c7;"></p>
 
  <script>
    function show() {
      let val = document.getElementById('userInput').value;
      document.getElementById('result').innerText = "Result: Hello, " + val + "! Welcome.";
    }
  </script>
</body>
