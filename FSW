<!DOCTYPE html>
<html>
<body>
  <h3>Registration Form Validation</h3>
  <form onsubmit="return validate()">
    <input id="fn" placeholder="First Name"><br><br>
    <input id="ln" placeholder="Last Name"><br><br>
    <input id="dob" type="date"><br><br>
    <input id="phone" placeholder="10-digit Phone"><br><br>
    <input id="email" placeholder="Email Address"><br><br>
    <button type="submit">Submit</button>
  </form>
  <p id="err" style="color:red; font-weight:bold;"></p>
 
  <script>
    function validate() {
      let fn = document.getElementById('fn').value.trim();
      let ln = document.getElementById('ln').value.trim();
      let dob = document.getElementById('dob').value;
      let phone = document.getElementById('phone').value.trim();
      let email = document.getElementById('email').value.trim();
      let msg = document.getElementById('err');
      if (!fn || !ln || !dob || !phone || !email) { msg.innerText = "Error: All fields are required!"; return false; }
      if (!/^\d{10}$/.test(phone)) { msg.innerText = "Error: Phone number must be exactly 10 digits!"; return false; }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { msg.innerText = "Error: Invalid Email format!"; return false; }
      alert("Registration Successful!");
      return true;
    }
  </script>
</body>
</html>



