const express = require('express');
const mongoose = require('mongoose');
const app = express();

app.use(express.json());
app.use(express.static('public'));

mongoose.connect('mongodb://127.0.0.1:27017/StudentDB')
.then(() => console.log('MongoDB Connected'))
.catch(err => console.log(err));

const Student = mongoose.model('Student', {
    name: String,
    usn: String,
    course: String,
    semester: String
});

app.get('/students', async (req, res) => {
    res.json(await Student.find());
});

app.post('/students', async (req, res) => {
    res.json(await Student.create(req.body));
});

app.put('/students/:id', async (req, res) => {
    const s = await Student.findByIdAndUpdate(
        req.params.id, req.body, { new: true }
    );
    res.json(s);
});

app.delete('/students/:id', async (req, res) => {
    await Student.findByIdAndDelete(req.params.id);
    res.json({ message: 'Student deleted' });
});

app.listen(3000, () => console.log('Server running on port 3000'));


<!DOCTYPE html>
<html>
<head>
<title>Student Management</title>
<style>
body{font-family:Arial;background:lightblue;text-align:center}
form,table{background:white;margin:20px auto;padding:15px}
input,select,button{padding:8px;margin:5px}
table{border-collapse:collapse;width:90%}
th,td{border:1px solid black;padding:10px}
th{background:blue;color:white}
</style>
</head>
<body>

<h2>Student Management System</h2>

<form id="form">
<input id="name" placeholder="Name" required>
<input id="usn" placeholder="USN" required>
<input id="course" placeholder="Course" required>

<select id="semester" required>
<option value="">Semester</option>
<option>1</option><option>2</option>
<option>3</option><option>4</option>
<option>5</option><option>6</option>
</select>

<button type="submit">Save Student</button>
</form>

<table>
<thead>
<tr>
<th>Name</th><th>USN</th><th>Course</th>
<th>Semester</th><th>Action</th>
</tr>
</thead>
<tbody id="list"></tbody>
</table>

<script>
let editId = null;

async function load() {
    let data = await (await fetch('/students')).json();
    list.innerHTML = '';

    data.forEach(s => {
        let tr = document.createElement('tr');

        [s.name, s.usn, s.course, s.semester].forEach(v => {
            let td = document.createElement('td');
            td.textContent = v;
            tr.appendChild(td);
        });

        let td = document.createElement('td');
        let edit = document.createElement('button');
        edit.textContent = 'Edit';
        edit.onclick = () => {
            name.value = s.name;
            usn.value = s.usn;
            course.value = s.course;
            semester.value = s.semester;
            editId = s._id;
        };

        let del = document.createElement('button');
        del.textContent = 'Delete';
        del.onclick = async () => {
            await fetch('/students/' + s._id, {method:'DELETE'});
            load();
        };

        td.append(edit, del);
        tr.appendChild(td);
        list.appendChild(tr);
    });
}

form.onsubmit = async e => {
    e.preventDefault();

    let student = {
        name: name.value,
        usn: usn.value,
        course: course.value,
        semester: semester.value
    };

    await fetch(editId ? '/students/' + editId : '/students', {
        method: editId ? 'PUT' : 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify(student)
    });

    editId = null;
    form.reset();
    load();
};

load();
</script>
</body>
</html>


