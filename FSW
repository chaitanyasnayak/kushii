<!DOCTYPE html>
<html>
<head>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <style>#box { width: 100px; height: 100px; background: #f97316; margin: 10px 0; border-radius: 8px; color: white; display: flex; align-items: center; justify-content: center; font-weight: bold; }</style>
</head>
<body>
  <h3>jQuery DOM Effects Demo</h3>
  <p id="para">This is a paragraph to hide/show.</p>
  <button id="btnHide">Hide</button> <button id="btnShow">Show</button>
  <hr>
  <div id="box">BOX</div>
  <button id="btnFadeOut">Fade Out</button> <button id="btnFadeIn">Fade In</button> <button id="btnToggle">fadeToggle()</button>
  <script>
    $(document).ready(function() {
      $('#btnHide').click(() => $('#para').hide());
      $('#btnShow').click(() => $('#para').show());
      $('#btnFadeOut').click(() => $('#box').fadeOut());
      $('#btnFadeIn').click(() => $('#box').fadeIn());
      $('#btnToggle').click(() => $('#box').fadeToggle());
    });
  </script>
</body>
</html>



