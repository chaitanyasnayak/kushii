5. Water Jug Problem
from collections import deque

def bfs(a,b,t):
   q = deque([(0,0)])
   v = set()

   while q:
       x,y = q.popleft()
       if (x,y) in v: continue
       v.add((x,y))

       print("Visited state: X =",x,"L, Y =",y,"L")

       if x == t or y == t:
           print("Goal reached!")
           return

       p = min(x,b-y)
       r = min(y,a-x)

       q.extend([(a,y),(x,b),(0,y),(x,0),
                 (x-p,y+p),(x+r,y-r)])

   print("No solution found.")

bfs(4,3,2)
