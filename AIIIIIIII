from queue import PriorityQueue

g = {'A':[('B',2),('C',5)], 'B':[('D',1),('E',4)],
    'C':[('F',2)], 'D':[('G',3)], 'E':[('G',1)],
    'F':[('G',2)], 'G':[]}

q = PriorityQueue()
q.put((0,'A'))
v, path, total = set(), [], 0

while not q.empty():
   c, n = q.get()
   if n in v: continue

   print("Visiting:", n, "(Cost:", c, ")")
   v.add(n)
   path.append(n)
   total += c

   if n == 'G':
       print("Goal Node Reached!")
       break

   for x, w in g[n]:
       if x not in v:
           print("Adding neighbour:", x, "(Weight:", w, ")")
           q.put((w,x))

print("Path:", " → ".join(path))
print("Total Cost:", total)




2. MinMax Algorithm
v = [3,5,2,9,12,5,23,23]

def minimax(d, i, m):
   if d == 3:
       return v[i]

   a = minimax(d+1, i*2, not m)
   b = minimax(d+1, i*2+1, not m)

   return max(a,b) if m else min(a,b)

print("Leaf values:", v)
print("Best value according to Minimax:", minimax(0,0,True))





3. Cryptarithmetic Problem
from itertools import permutations

a = input("Enter first word: ").upper()
b = input("Enter second word: ").upper()
c = input("Enter result word: ").upper()

l = set(a+b+c)

if len(l) > 10:
   print("Too many letters! Maximum is 10.")
else:
   for d in permutations(range(10), len(l)):
       m = dict(zip(l,d))

       if m[a[0]] == 0 or m[b[0]] == 0 or m[c[0]] == 0:
           continue

       x = int(''.join(str(m[i]) for i in a))
       y = int(''.join(str(m[i]) for i in b))
       z = int(''.join(str(m[i]) for i in c))

       if x+y == z:
           print("Solution found:")
           print(m)
           print(x, "+", y, "=", z)
           break
   else:
       print("No solution found")





